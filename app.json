{
  "expo": {
    "name": "MIF",
    "slug": "mif",
    "scheme": "mif",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/mif-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lguplusb2b.mif"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/mif-android-foreground.png",
        "backgroundImage": "./assets/mif-android-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": false,
      "package": "com.lguplusb2b.mif",
      "versionCode": 10,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/mif-splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#007C91",
          "defaultChannel": "mif-orders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "774443a8-2685-4328-8717-38795f4ed53d"
      }
    },
    "owner": "greencart7"
  }
}
