# MIF 전용 서버 환경 변수. 실제 값은 배포 환경에서만 설정합니다.
PORT=3000
EXPO_PUBLIC_MIF_API_URL=https://api.example.com
DATABASE_URL=postgresql://mif_user:replace_me@localhost:5432/mif
MIF_ALLOWED_ORIGIN=mif://
S3_REGION=ap-northeast-2
S3_BUCKET=mif-private-documents
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
SWEETTRACKER_API_KEY=replace_me
KAKAO_REST_API_KEY=replace_me
